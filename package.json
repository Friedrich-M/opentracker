{
  "name": "opentracker",
  "version": "1.2.2",
  "description": "Self-hosted web analytics with visitor activity, session replay and heatmaps.",
  "author": "Friedrich-M",
  "license": "MIT",
  "type": "module",
  "engines": {
    "pnpm": "12.3.4",
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "dotenv next dev --turbo",
    "build": "npm-run-all check:env build:db check:db build:tracker build:recorder build:geo build:openapi build:app",
    "start": "next start",
    "build:app": "next build --turbo",
    "build:cloudflare": "npm-run-all build:db check:db build:tracker build:recorder build:openapi build:cloudflare:worker",
    "build:cloudflare:worker": "node scripts/build/cloudflare.js",
    "build:icons": "svgr ./src/assets --out-dir src/components/svg --typescript",
    "build:tracker": "npm-run-all check:tracker build:tracker:script",
    "build:tracker:script": "rollup -c src/tracker/rollup.config.js",
    "build:tracker:types": "tsc -p src/tracker/tsconfig.types.json && biome format --write src/tracker/index.d.ts",
    "check:tracker": "tsc -p src/tracker/tsconfig.json --noEmit",
    "build:recorder": "rollup -c src/recorder/rollup.config.js",
    "build:prisma:client": "node scripts/build/prisma-client.js",
    "build:geo": "node scripts/build/geo.js",
    "build:openapi": "npm-run-all openapi:generate",
    "build:db": "npm-run-all generate:db:client build:prisma:client",
    "generate:db:client": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "check:db": "node scripts/build/check-db.js",
    "check:env": "node scripts/build/check-env.js",
    "check:repository": "node scripts/checks/repository.mjs",
    "check:messages": "node scripts/checks/messages.js",
    "openapi:generate": "tsx scripts/openapi/generate.ts",
    "openapi:contracts": "tsx scripts/openapi/contracts.ts",
    "openapi:check": "tsx scripts/openapi/check.ts",
    "pretest": "pnpm generate:db:client",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx scripts/dev/seed.ts",
    "db:local": "tsx scripts/dev/local-db.ts",
    "screenshot": "tsx scripts/dev/screenshot.ts",
    "deploy:vercel": "sh scripts/deploy/vercel.sh",
    "deploy:cloudflare": "sh scripts/deploy/cloudflare.sh",
    "typecheck": "tsc --noEmit",
    "check:unused": "knip --include files,dependencies,unlisted,exports,types",
    "verify": "npm-run-all check:repository check:repository:tests build:db openapi:generate openapi:check typecheck test",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write",
    "check:quality": "npm-run-all check:unused lint check:messages",
    "check:repository:tests": "node --test scripts/checks/repository.test.mjs"
  },
  "cacheDirectories": [
    ".next/cache"
  ],
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/extension-read-replicas": "^0.5.0",
    "@tanstack/react-query": "^5.102.8",
    "@umami/react-zen": "^0.254.0",
    "bcryptjs": "^3.0.2",
    "chalk": "^5.6.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "colord": "^2.10.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "debug": "^4.4.3",
    "detect-browser": "^5.2.0",
    "dotenv": "^17.4.2",
    "immer": "^11.1.18",
    "ipaddr.js": "^2.5.0",
    "is-localhost-ip": "^3.0.1",
    "isbot": "^5.2.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.44.0",
    "maxmind": "^5.0.7",
    "motion": "^12.43.0",
    "next": "16.4.3",
    "next-intl": "4.13.4",
    "otplib": "^13.5.0",
    "papaparse": "^5.7.0",
    "prop-types": "^15.8.1",
    "punycode": "^2.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-simple-maps": "^3.0.0",
    "react-window": "^2.3.1",
    "rrweb": "^2.0.1",
    "rrweb-player": "2.0.0-alpha.20",
    "serialize-error": "^13.0.1",
    "thenby": "^1.4.1",
    "ua-parser-js": "^1.0.41",
    "uuid": "^14.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@svgr/cli": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ua-parser-js": "^0.7.39",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "dotenv-cli": "^11.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "knip": "^5.88.1",
    "msw": "^2.15.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "11.3.2",
    "prisma": "^7.10.0",
    "rollup": "^4.63.1",
    "tar": "^7.5.22",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "4.152.0",
    "zod-openapi": "^6.0.2"
  },
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Friedrich-M/opentracker.git"
  },
  "bugs": {
    "url": "https://github.com/Friedrich-M/opentracker/issues"
  },
  "homepage": "https://github.com/Friedrich-M/opentracker#readme"
}
