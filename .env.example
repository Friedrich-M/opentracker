# Local development only. Copy to .env; never commit real configuration.
DATABASE_URL=postgresql://tracker:tracker@localhost:55432/tracker
# Optional direct PostgreSQL connection for migrations; blank uses DATABASE_URL.
DIRECT_DATABASE_URL=
# Generate your own values with: openssl rand -hex 32
APP_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
# Optional internal-visit marker. It does not grant dashboard access.
OWNER_MARK=
OWNER_COOKIE_DOMAIN=
IGNORE_IP=
# The one proxy header carrying the visitor's address in production, e.g. x-real-ip
# behind the Nginx template; Vercel defaults to x-real-ip. Blank locally.
CLIENT_IP_HEADER=
# Set to 1 for geolocation downloads during a Vercel build.
BUILD_GEO=1
MAXMIND_LICENSE_KEY=
# Set both to use the optional Cloudflare R2 replay store; leave both blank locally.
REPLAY_STORE_URL=
REPLAY_STORE_SECRET=
CRON_SECRET=
REPLAY_RETENTION_DAYS=14
# Optional: countries recorded in replays (default US,CN,HK,SG; * for all), the
# per-visit chunk cap, heatmap retention in days (blank keeps them) and the tags
# listed first in the Projects tabs (comma-separated, read at build time).
REPLAY_COUNTRIES=
REPLAY_MAX_CHUNKS_PER_VISIT=
HEATMAP_RETENTION_DAYS=
NEXT_PUBLIC_PROJECT_ORDER=
